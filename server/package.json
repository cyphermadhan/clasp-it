{
  "name": "clasp-it-server",
  "version": "1.0.0",
  "description": "MCP server for clasp-it element context",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build:extension": "cd .. && zip -r server/public/downloads/clasp-it-extension.zip extension/ -x '*.DS_Store' -x '__MACOSX/*' -x '*.git*'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.5",
    "dodopayments": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.3.2",
    "multer": "^2.0.0",
    "pg": "^8.11.5",
    "resend": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.18",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.2.0",
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "router": {
      "path-to-regexp": "^8.4.2"
    }
  }
}
