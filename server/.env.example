# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=*

# ─── Storage ──────────────────────────────────────────────────────────────────
# Leave unset to use in-memory storage (local dev only)
DATABASE_URL=postgresql://user:password@localhost:5432/clasp_it
REDIS_URL=redis://localhost:6379

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Leave unset to print magic links to console instead of sending email
RESEND_API_KEY=re_...
RESEND_FROM=noreply@clasp-it.com

# ─── Dodo Payments ────────────────────────────────────────────────────────────
DODO_API_KEY=sk_test_...
DODO_WEBHOOK_KEY=whsec_...
DODO_PRODUCT_PRO_MONTHLY=prd_...     # $8/month
DODO_PRODUCT_PRO_ANNUAL=prd_...      # $72/year
DODO_PRODUCT_TOPUP_25=prd_...        # $5 = +25 picks-with-attachments (current month)
DODO_ENV=live_mode                   # test_mode | live_mode

# ─── Cloudflare R2 (attachments) ──────────────────────────────────────────────
# Leave unset to disable attachment storage (attachments endpoints become no-ops)
R2_ACCOUNT_ID=                       # subdomain in your R2 endpoint URL
R2_ACCESS_KEY_ID=                    # from "Manage R2 API Tokens" → Object Read & Write
R2_SECRET_ACCESS_KEY=                # shown once at token creation
R2_BUCKET=claspit-attachments

# ─── Cleanup sweeper ──────────────────────────────────────────────────────────
# Daily background job removes orphan R2 + DB attachment rows.
CLEANUP_OLDER_THAN_DAYS=28           # default: 28
CLEANUP_INTERVAL_HOURS=24            # default: 24

# ─── App ──────────────────────────────────────────────────────────────────────
# Used for magic link redirects and return URLs
APP_URL=http://localhost:5500
